# Supabase project (create a NEW project for this product — do not reuse
# fountain-city-capital's, or any other project's, credentials).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Used only by scripts/run-migration.mjs to apply supabase/migrations/*.sql
# directly (Session Pooler / non-pooling connection string, from Supabase's
# Database Settings page).
POSTGRES_URL_NON_POOLING=

# SAM.gov (free — register at https://sam.gov/data-services). Needed for
# /api/sync-opportunities (contracts) only — /api/sync-grants (USAspending.gov
# + Grants.gov) needs no API key at all.
SAM_GOV_API_KEY=

# Admin dashboard
ADMIN_PASSWORD=
# Shared secret the sync cron sends as "Authorization: Bearer <value>".
CRON_SECRET=

# Self-hosting only (leave unset on Vercel, where this is automatic): admin
# and subscriber login lockout key on the caller's IP from X-Real-IP /
# X-Forwarded-For, which are only trusted if this is "1" or "true" (case-insensitive) AND your reverse
# proxy is configured to overwrite (not just add to) those headers with the
# real client IP before this app ever sees the request. If either is untrue,
# leave this unset -- every visitor then shares one lockout bucket instead
# of an attacker being able to spoof a fresh IP on every login attempt to
# bypass lockout entirely, which is worse. See @netacracy/bid-core's
# src/request-ip.ts for the full reasoning.
TRUST_PROXY_HEADERS=

# Founder-fallback BCC only (digest + sync-error mail when FOUNDER_DIGEST_BCC
# is unset). Leave unset to disable email notifications entirely (the sync
# job still runs and the dashboard still updates — this only gates email).
NOTIFY_EMAIL_TO=

# Founder copy of customer digests + sync-error mail. Falls back to NOTIFY_EMAIL_TO.
FOUNDER_DIGEST_BCC=

# Outbound SMTP for the notification emails above (any provider — Resend,
# Postmark, SES SMTP, etc). Leave unset and NOTIFY_EMAIL_TO is a no-op.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Subscriber sessions (HMAC). Independent of ADMIN_PASSWORD.
SUBSCRIBER_SESSION_SECRET=

# Stripe Payment Link for /start. Leave unset to show the fallback sentence.
# On the Payment Link itself (Stripe Dashboard), turn on "Collect customer
# names" and add a Text custom field with key "company" -- the webhook below
# reads both, and self-serve provisioning fails without at least "company".
NEXT_PUBLIC_STRIPE_PAYMENT_LINK_URL=

# Self-serve provisioning: /api/stripe-webhook listens for
# checkout.session.completed and auto-creates the subscriber seat (same
# path /admin/subscribers uses manually). STRIPE_SECRET_KEY is the API key;
# STRIPE_WEBHOOK_SECRET is the signing secret from the webhook endpoint's
# settings in the Stripe Dashboard (needed to verify a request actually came
# from Stripe). Leave either unset and the webhook route just 500s --
# provisioning falls back to the existing manual /admin/subscribers flow.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Price id for THIS product (price_...). Required once more than
# one BID app shares the Stripe account -- the webhook ignores checkouts
# and invoices billed on a different price.
STRIPE_PRICE_ID=

# Public site URL, used for canonical links, sitemap.xml, robots.txt, and
# resolving the Open Graph image. Set to the real deployed domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
